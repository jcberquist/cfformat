{
  "mode": "script",
  "bom": false,
  "newline": "lf",
  "root": {
    "kind": "root",
    "children": [
      {
        "kind": "statement",
        "stmt": "assignment",
        "terminator": ";",
        "children": [
          {
            "kind": "assignment",
            "children": [
              { "k": "ident.variable", "t": "a" },
              { "k": "op.assign", "t": "=" },
              { "kind": "array", "open": "[", "close": "]" }
            ]
          }
        ]
      },
      { "k": "nl", "t": "\n" }
    ]
  }
}
